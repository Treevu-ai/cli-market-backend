FROM python:3.12-slim
WORKDIR /app

# Build deps for asyncpg + Playwright browsers (git for cli-market-index)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev git \
    libnspr4 libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libdbus-1-3 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libpango-1.0-0 libcairo2 libasound2 && \
    rm -rf /var/lib/apt/lists/*

# cli-market-core from PyPI; cli-market-index from private git (requirements-private.txt).
# Fly.io → collector service → `fly secrets set`: GITHUB_TOKEN or GH_TOKEN (PAT, repo read on cli-market-index).
ARG GITHUB_TOKEN
ARG GH_TOKEN
ARG CACHE_BUST=2026-06-23-core-8469854

COPY requirements.txt requirements-private.txt .
RUN set -eux; \
    echo "cache_bust=${CACHE_BUST}"; \
    INDEX_TOKEN="${GITHUB_TOKEN:-${GH_TOKEN:-}}"; \
    if [ -z "${INDEX_TOKEN}" ]; then \
      echo "error: set GITHUB_TOKEN or GH_TOKEN on Fly.io for cli-market-index (git+https)" >&2; \
      exit 1; \
    fi; \
    git config --global url."https://x-access-token:${INDEX_TOKEN}@github.com/".insteadOf "https://github.com/"; \
    pip install --no-cache-dir -r requirements.txt -r requirements-private.txt; \
    playwright install chromium; \
    rm -f /root/.gitconfig

# index_gate.py + price_snapshots_schema.py (golden-record linking) are
# backend-repo local files, not part of the cli-market-core PyPI package —
# collect_prices.py imports them at runtime inside _run_index_cycle(), but
# they were never copied into this image, so it silently failed with
# "No module named 'index_gate'" every cycle (caught by its own try/except).
# market_alerts/market_indicators ship as flat top-level modules inside the
# cli-market-core PyPI package itself, so those need no extra COPY.
#
# Pulse-cache refresh does NOT get the same treatment: it needs
# commerce_pulse_cache -> market_pulse -> market_brief AND routers.dashboard
# (a whole package with its own deep dependency chain) — copying all of that
# into this minimal image just to warm a cache would be the wrong fix.
# collect_prices.py instead calls POST /admin/cron/pulse-cache-refresh on
# cli-market-api over HTTP, where all of that already lives.
COPY collect_prices.py index_gate.py price_snapshots_schema.py ./

ENV PYTHONUNBUFFERED=1
CMD ["python", "collect_prices.py", "--daemon"]