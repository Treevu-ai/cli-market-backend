FROM python:3.12-slim
WORKDIR /app

# Build deps for asyncpg + Playwright browsers (git for private git+https deps)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev git \
    libnspr4 libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libdbus-1-3 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libpango-1.0-0 libcairo2 libasound2 && \
    rm -rf /var/lib/apt/lists/*

# cli-market-core and cli-market-index are private GitHub repos (git+https in
# requirements.txt). Pass a fine-grained or classic PAT with repo read scope.
# Railway: set GITHUB_TOKEN on the collector service and enable "Available at
# Build Time" so Railway forwards it as this Docker build-arg.
ARG GITHUB_TOKEN

COPY requirements.txt .
RUN set -eux; \
    if [ -z "${GITHUB_TOKEN:-}" ]; then \
      echo "ERROR: GITHUB_TOKEN build-arg is required to install private GitHub dependencies." >&2; \
      echo "Railway: add GITHUB_TOKEN to the collector service with build-time access enabled." >&2; \
      exit 1; \
    fi; \
    git config --global url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"; \
    pip install --no-cache-dir -r requirements.txt; \
    git config --global --remove-section url; \
    playwright install chromium

COPY collect_prices.py ./

ENV PYTHONUNBUFFERED=1
CMD ["python", "collect_prices.py", "--daemon"]