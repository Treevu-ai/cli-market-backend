FROM python:3.12-slim
WORKDIR /app

# Build deps for asyncpg + Playwright browsers (git for the git+https core dep)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev git \
    libnspr4 libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libdbus-1-3 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libpango-1.0-0 libcairo2 libasound2 && \
    rm -rf /var/lib/apt/lists/*

# The collector depends on the shared core library (cli-market-core), pinned by
# commit in requirements.txt and installed from its public GitHub repo (no auth).
# The data-moat modules and market_connectors/ now live there — only the
# collector entrypoint stays in-tree.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    playwright install chromium

COPY collect_prices.py ./

ENV PYTHONUNBUFFERED=1
CMD ["python", "collect_prices.py", "--daemon"]
