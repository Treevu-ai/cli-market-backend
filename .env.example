# CLI Market Backend — Environment Variables
# Copy to .env and fill in real values before running locally.
# Never commit .env to version control.

# ── Database ───────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (dev). Set to postgres:// for production.
DATABASE_URL=

# SQLite / data directory (ignored when DATABASE_URL is set)
MARKET_DATA_DIR=~/.market

# PostgreSQL SSL mode: prefer | require | disable
PG_SSL_MODE=prefer

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# Comma-separated origins for CORS
CORS_ORIGINS=https://cli-market.dev,http://localhost:3000

# ── Auth & Security ───────────────────────────────────────────────────────────
# Secret token for /admin/* endpoints. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MARKET_API_TOKEN=

# Admin password for the auto-created admin user on first boot (REQUIRED - no default)
MARKET_ADMIN_PASSWORD=change-me-in-production

# Self-URL used for internal API calls (collector → server)
MARKET_API_URL=http://127.0.0.1:8765

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MIN=60       # Max requests per minute per IP
RATE_LIMIT_DAY=1000     # Max requests per day per IP
RATE_LIMIT_WINDOW=60    # Window size in seconds

# ── Search ────────────────────────────────────────────────────────────────────
SEARCH_TIMEOUT=15.0     # Per-store request timeout (seconds)

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to enforce strict payment validation
MARKET_ENV=

# ── Payments — PayPal ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=
# Set to "1" only in local dev to skip webhook signature verification
PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS=

# ── Payments — Generic Webhook ────────────────────────────────────────────────
CHECKOUT_WEBHOOK_SECRET=

# ── Price Collector Daemon ────────────────────────────────────────────────────
COLLECT_PARALLEL=6              # Concurrent store requests
COLLECT_DELAY=0.75              # Delay between requests (seconds)
COLLECT_INTERVAL_HOURS=4        # How often the daemon re-collects
COLLECT_MAX_QUERIES_PER_LINE=12 # Max product queries per business line
COLLECT_EXPANSION=3             # Synthetic query expansion multiplier
